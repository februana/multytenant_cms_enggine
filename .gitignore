```
# Backup and deployment artifacts
backups/
deploy/*.sh

# Configuration and data files that might contain sensitive info
*.json
config.json
.env
.env.local
*.env.*

# Log files
*.log

# Temporary files
*.tmp
*.swp

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd

# Build outputs
build/
dist/
target/

# Dependencies
node_modules/
venv/
.venv/
```