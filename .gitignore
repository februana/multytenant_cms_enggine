```gitignore
# Compiled and binary files
*.pyc
*.pyo
*.pyd
*.class
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Dependencies
venv/
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Build artifacts
build/
dist/
*.egg

# Environment files
.env
.env.local
*.env.*

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Coverage
coverage/
htmlcov/
.coverage

# OS generated files
.DS_Store
Thumbs.db
```