# Apache SSL/HTTPS configuration for Wedding Invitation Web Application
# Production-ready template with PHP-FPM, security headers, and WebDAV support
#
# Placeholders (to be replaced by installer):
# {{DOMAIN}} - Your domain name
# {{DOCUMENT_ROOT}} - Document root path
# {{PHP_SOCKET}} - PHP-FPM socket path
# {{LETSENCRYPT_PATH}} - Path to Let's Encrypt certificates
# {{LOG_PATH}} - Log directory path

<VirtualHost *:443>
    ServerName {{DOMAIN}}
    ServerAlias www.{{DOMAIN}}
    DocumentRoot {{DOCUMENT_ROOT}}

    # SSL Configuration
    SSLEngine on
    SSLCertificateFile {{LETSENCRYPT_PATH}}/fullchain.pem
    SSLCertificateKeyFile {{LETSENCRYPT_PATH}}/privkey.pem
    SSLCertificateChainFile {{LETSENCRYPT_PATH}}/chain.pem

    # Modern SSL configuration
    SSLProtocol all -SSLv2 -SSLv3 -TLSv1 -TLSv1.1
    SSLCipherSuite ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
    SSLHonorCipherOrder off
    SSLSessionTickets on

    # Security Headers
    <IfModule mod_headers.c>
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always set X-Content-Type-Options "nosniff"
        Header always set X-XSS-Protection "1; mode=block"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    </IfModule>

    # Directory configuration
    <Directory {{DOCUMENT_ROOT}}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted

        # Enable mod_rewrite for clean URLs
        RewriteEngine On
    </Directory>

    # Block access to sensitive directories
    <DirectoryMatch "{{DOCUMENT_ROOT}}/(app|deploy|backups|\\.git)/">
        Require all denied
    </DirectoryMatch>

    # Block access to sensitive file types
    <FilesMatch "\.(json|sqlite|env|bak|backup|old|orig|save)$">
        Require all denied
    </FilesMatch>

    # Block access to hidden files (dotfiles)
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    # Disable PHP execution in uploads directory (security)
    <Directory {{DOCUMENT_ROOT}}/uploads>
        Require all granted
        Options Indexes FollowSymLinks
        DirectoryIndex none
        
        # Block PHP execution when accessed directly as files
        <FilesMatch "\.php$">
            Require all denied
        </FilesMatch>
    </Directory>

    # WebDAV configuration for /webdav URL endpoint (separate from CMS uploads)
    Alias /webdav {{DOCUMENT_ROOT}}/webdav
    
    <Location /webdav>
        DAV On
        AuthType Basic
        AuthName "Wedding WebDAV"
        AuthUserFile /etc/apache2/.davpasswd
        Require valid-user
        
        # Allow WebDAV-specific methods
        <LimitExcept GET HEAD OPTIONS PROPFIND PROPPATCH PUT DELETE COPY MOVE MKCOL LOCK UNLOCK REPORT>
            Require all denied
        </LimitExcept>
    </Location>

    # Directory permissions for webdav - allow read but block PHP execution
    <Directory {{DOCUMENT_ROOT}}/webdav>
        Require all granted
        Options Indexes FollowSymLinks
        DirectoryIndex none
        
        # Block PHP execution when accessed directly as files
        <FilesMatch "\.php$">
            Require all denied
        </FilesMatch>
    </Directory>

    # PHP-FPM handler via ProxyFCG
    <FilesMatch \.php$>
        SetHandler "proxy:unix:{{PHP_SOCKET}}|fcgi://localhost/"
    </FilesMatch>

    # Upload size limit (20MB)
    LimitRequestBody 20971520

    # Cache static assets
    <IfModule mod_expires.c>
        ExpiresActive On
        ExpiresByType image/jpg "access plus 7 days"
        ExpiresByType image/jpeg "access plus 7 days"
        ExpiresByType image/png "access plus 7 days"
        ExpiresByType image/gif "access plus 7 days"
        ExpiresByType image/webp "access plus 7 days"
        ExpiresByType text/css "access plus 7 days"
        ExpiresByType application/javascript "access plus 7 days"
        ExpiresByType image/svg+xml "access plus 7 days"
        ExpiresByType image/x-icon "access plus 7 days"
        ExpiresByType font/woff "access plus 7 days"
        ExpiresByType font/woff2 "access plus 7 days"
        ExpiresByType font/ttf "access plus 7 days"
        ExpiresByType font/eot "access plus 7 days"
    </IfModule>

    <IfModule mod_headers.c>
        <FilesMatch "\.(jpg|jpeg|png|gif|webp|css|js|svg|ico|woff|woff2|ttf|eot)$">
            Header set Cache-Control "public, max-age=604800, immutable"
        </FilesMatch>
    </IfModule>

    ErrorLog {{LOG_PATH}}/wedding-ssl-error.log
    CustomLog {{LOG_PATH}}/wedding-ssl-access.log combined
</VirtualHost>
