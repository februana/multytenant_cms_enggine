# Deny direct access to sensitive files and disable directory listing
Options -Indexes
<FilesMatch "^(?:\.env(?:\.example)?|database\.sqlite|config\.json|guest-links\.json)$">
  Require all denied
</FilesMatch>

# Prevent serving of common sensitive filenames in gallery/thumbs
<FilesMatch "^(?:thumbs)$">
  Require all denied
</FilesMatch>

# Never serve tenant uploads as static files. Route them through media.php,
# which resolves the current Host tenant and checks the requested path against
# that tenant's media roots before reading the file.
RewriteEngine On
RewriteRule ^uploads/(.+)$ /media.php?path=uploads/$1 [END,NE]

# Rewrite the homepage and index.html to the PHP-powered front page
RewriteCond %{REQUEST_URI} ^/(|index\.html)$
RewriteRule ^(index\.html)?$ /index.php [L]
