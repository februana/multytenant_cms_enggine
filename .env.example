# Example .env file (DO NOT COMMIT your real .env to GitHub)
# Rename to .env and fill with real values on the server (keep .env out of repo)

ADMIN_USER=admin
ADMIN_PASS=
# Main domain is inserted into tenants during install; tenant domains are added in Super Admin.
UNDANGAN_MAIN_DOMAIN=
# Required for decrypting visible Tenant Admin passwords in the Super Admin dashboard.
# Generate with: openssl rand -hex 32
UNDANGAN_PASSWORD_KEY=
UNDANGAN_AUTO_PROVISION=1
WHATSAPP_NUMBER=6285162909164
WHATSAPP_MESSAGE=Assalamu'alaikum Andi & Februana, saya ingin mengonfirmasi kehadiran untuk acara pernikahan.

# Optional: canonical SQLite DB path. All tenant configuration, guest links,
# custom CSS, and calendar data are stored in this database.
# Example: UNDANGAN_DB_PATH=/var/www/private/database.sqlite
UNDANGAN_DB_PATH=
MAX_UPLOAD_SIZE=5242880
SESSION_TIMEOUT=3600
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp

